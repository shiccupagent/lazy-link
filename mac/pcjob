# ---- live prices: "cheap_feed" in config.json picks the cheapest hours of each day from a free public feed ----
# ComEd (Northern Illinois, USA), checked 2026-10-30:
#   https://hourlypricing.comed.com/api?type=daynexttomorrow&format=json  tomorrow's day-ahead, [] until published
#   https://hourlypricing.comed.com/api?type=5minutefeed&format=json      the last 24 h, 5-minute slots (guess when day-ahead is empty)
#   rows are {"millisUTC": "...", "price": "3.0"} in cents/kWh
# Octopus Energy Agile (UK), checked 2026-10-30, no key:
#   https://api.octopus.energy/v1/products/?is_variable=true              the product list; the Agile code changes, so pick the newest open one
#   https://api.octopus.energy/v1/products/<CODE>/electricity-tariffs/E-1R-<CODE>-<REGION>/standard-unit-rates/?period_from=..&period_to=..
#   half-hourly rows {"valid_from", "valid_to", "value_inc_vat"} in pence/kWh, newest first, paged with "next"
COMED_API = "https://hourlypricing.comed.com/api"
OCTOPUS_API = "https://api.octopus.energy/v1"
CHEAP_FEED = CFG.get("cheap_feed") or None
CHEAP_FEED_HOURS = CFG.get("cheap_feed_hours", 6)
CHEAP_CACHE = CONFIG.with_name(".cheap-feed-cache.json")
FEED_TIMEOUT_S = 10
FEED_MAX_AGE_S = 3 * 3600      # refetch at least this often
FEED_COVER_S = 12 * 3600       # the prices should reach this far ahead
FEED_RETRY_S = 30 * 60         # after a failure, or a feed that ends too soon, wait this long before asking again
_feed_retry_at = 0.0
if CHEAP_FEED is not None:
    if not isinstance(CHEAP_FEED, dict) or CHEAP_FEED.get("source") not in ("comed", "octopus") or \
            (CHEAP_FEED.get("source") == "octopus" and not re.fullmatch(r"[A-Za-z]", str(CHEAP_FEED.get("region", "")))):
        sys.exit('pcjob: cheap_feed in config.json must be {"source": "comed"} or {"source": "octopus", "region": "C"}')
    if not isinstance(CHEAP_FEED_HOURS, int) or isinstance(CHEAP_FEED_HOURS, bool) or not 1 <= CHEAP_FEED_HOURS <= 24:
        sys.exit("pcjob: cheap_feed_hours in config.json must be a whole number from 1 to 24")


def _get_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": "lazy-link-pcjob"})
    with urllib.request.urlopen(req, timeout=FEED_TIMEOUT_S) as r:
        return json.loads(r.read().decode("utf-8-sig"))


def _utc(t):
    return datetime.fromtimestamp(t, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _iso_epoch(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()


def _hour_start(t):
    """The start of the local hour that contains epoch time t."""
    return int(datetime.fromtimestamp(t).replace(minute=0, second=0, microsecond=0).timestamp())


def _octopus_pages(url):
    while url:
        d = _get_json(url)
        yield from d["results"]
        url = d.get("next")


def _comed_slots():
    day_ahead = [(int(r["millisUTC"]) / 1000, float(r["price"]))
                 for r in _get_json(f"{COMED_API}?type=daynexttomorrow&format=json")]
    if day_ahead:
        return day_ahead, "ComEd day-ahead prices"
    # not published yet: the last 24 h, moved on by one day, is the guess for the next 24 h
    last_day = [(int(r["millisUTC"]) / 1000 + 86400, float(r["price"]))
                for r in _get_json(f"{COMED_API}?type=5minutefeed&format=json")]
    return last_day, "ComEd last day's prices (day-ahead not out yet)"


def _octopus_slots(region):
    agile = [p for p in _octopus_pages(f"{OCTOPUS_API}/products/?is_variable=true")
             if p["code"].startswith("AGILE-") and "OUTGOING" not in p["code"]
             and p.get("direction") == "IMPORT" and not p.get("available_to")]
    if not agile:
        raise ValueError("no open Agile import tariff on the Octopus product list")
    code = max(agile, key=lambda p: _iso_epoch(p["available_from"]))["code"]
    start = int(time.time() // 3600) * 3600
    url = (f"{OCTOPUS_API}/products/{code}/electricity-tariffs/E-1R-{code}-{region}/standard-unit-rates/"
           f"?period_from={_utc(start)}&period_to={_utc(start + 86400)}&page_size=100")
    slots = [(_iso_epoch(r["valid_from"]), float(r["value_inc_vat"])) for r in _octopus_pages(url)]
    return slots, f"Octopus Agile {code} (region {region})"


def _pick(slots, now, n):
    """Average the prices into whole local hours, keep the next 24 h, take the n cheapest hours.
    Returns ([[start, end], ...] epoch windows in time order, when the prices run out)."""
    by_hour = {}
    for t, price in slots:
        by_hour.setdefault(_hour_start(t), []).append(price)
    if not by_hour:
        raise ValueError("the feed had no prices")
    first = _hour_start(now)
    avg = {h: sum(v) / len(v) for h, v in by_hour.items() if first <= h < now + 86400}
    if not avg:
        raise ValueError("the feed had no prices for the next 24 h")
    spans = []
    for h in sorted(sorted(avg, key=avg.get)[:n]):
        if spans and spans[-1][1] == h:
            spans[-1][1] = h + 3600
        else:
            spans.append([h, h + 3600])
    return spans, max(by_hour) + 3600


def _clock_min(t):
    lt = time.localtime(t)
    return lt.tm_hour * 60 + lt.tm_min


def _feed_key():
    return json.dumps([CHEAP_FEED, CHEAP_FEED_HOURS], sort_keys=True)


def _read_cache():
    try:
        c = json.loads(CHEAP_CACHE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    ok = isinstance(c, dict) and c.get("key") == _feed_key() and all(k in c for k in ("fetched_at", "covers_until", "label", "windows"))
    return c if ok else None


def _fetch_plan(now):
    src = CHEAP_FEED["source"]
    if src == "comed":
        slots, label = _comed_slots()
    else:
        slots, label = _octopus_slots(CHEAP_FEED["region"].upper())
    spans, covers = _pick(slots, now, CHEAP_FEED_HOURS)
    return {"key": _feed_key(), "fetched_at": int(now), "covers_until": covers, "label": label,
            "windows": [[_clock_min(a) % 1440, _clock_min(b) % 1440] for a, b in spans]}


def cheap_feed_plan(now=None):
    """The live feed's plan ({"label", "windows", ...}), or None when the feed is off or down.
    Uses the cache file while it is fresh; asks the feed at most once per FEED_RETRY_S. Never raises."""
    global _feed_retry_at
    now = time.time() if now is None else now
    c = _read_cache()
    if c and now - c["fetched_at"] < FEED_MAX_AGE_S and (c["covers_until"] >= now + FEED_COVER_S or now - c["fetched_at"] < FEED_RETRY_S):
        return c
    if now < _feed_retry_at:
        return None
    try:
        plan = _fetch_plan(now)
    except Exception as e:   # any trouble with the feed: fall back, never crash a job
        _feed_retry_at = now + FEED_RETRY_S
        fallback = "cheap_hours instead" if CFG.get("cheap_hours") else "no cheap_hours fallback set"
        print(f"pcjob: live price feed unavailable ({e.__class__.__name__}: {e}); using {fallback}", file=sys.stderr, flush=True)
        return None
    try:
        CHEAP_CACHE.write_text(json.dumps(plan) + "\n", encoding="utf-8")
    except OSError:
        pass
    return plan


def span_text(ws):
    return ", ".join(f"{a // 60:02d}:{a % 60:02d}-{b // 60:02d}:{b % 60:02d}" for a, b in ws)


def fixed_windows():
    """config.json "cheap_hours": ["23:00-07:00", ...] (this computer's clock) -> [(start_min, end_min)]."""
    out = []
    for w in CFG.get("cheap_hours") or []:
        a, b = (int(h) * 60 + int(m) for h, m in (x.strip().split(":") for x in w.split("-")))
        out.append((a, b))
    return out


def cheap_source():
    """(label, [(start_min, end_min)]) for the hours in use: the live feed when it works, else cheap_hours.
    The label is None when neither gives any hours."""
    plan = cheap_feed_plan() if CHEAP_FEED else None
    if plan:
        return plan["label"], [tuple(w) for w in plan["windows"]]
    ws = fixed_windows()
    return ("cheap_hours" if ws else None), ws


def windows():
    """The cheap hours as [(start_min, end_min)] on this computer's clock (a window may wrap past midnight)."""
    return cheap_source()[1]


def minutes_to_cheap(now=None):
    """0 inside a cheap window, else minutes until the next one starts; None when no windows are set."""
    ws = windows()
    if not ws:
        return None
    t = time.localtime(now)
    m = t.tm_hour * 60 + t.tm_min
    if any((a <= m < b) if a < b else (m >= a or m < b) for a, b in ws):
        return 0
    return min((a - m) % 1440 for a, _ in ws)


def wait_for_cheap(force=False):
    """Hold a heavy job until electricity is cheap: with --cheap, LAZY_CHEAP=1, or "cheap_only": true in config.json."""
    if not (force or CFG.get("cheap_only") or os.environ.get("LAZY_CHEAP") == "1"):
        return
    label, ws = cheap_source()
    if not ws and not CHEAP_FEED:
        sys.exit("pcjob: --cheap needs \"cheap_hours\" or \"cheap_feed\" in config.json, e.g. [\"23:00-07:00\"] (see config.example.json)")
    left = minutes_to_cheap()
    if left is None:   # the live feed is down and there is no cheap_hours fallback: keep waiting, retry later
        print("pcjob: waiting: the live price feed is down and no cheap_hours fallback is set; retrying", flush=True)
    elif left:
        print(f"pcjob: waiting for cheap electricity: starts in {left // 60} h {left % 60:02d} min "
              f"({label}: {span_text(ws)})", flush=True)
    while minutes_to_cheap() != 0:
        time.sleep(30)


SENT = REPO / "mac" / "sent"   # local notes of what each sent job makes (gitignored); a dashboard can show them


def note_sent(job_id, src, a):
    """mac/sent/<id>.json: what a job makes and who it is for, read from the job folder as it is sent, so a
    dashboard can say more than "imagegen". The folder's about.json ({"what": ..., "for": ...}) if the sender
    wrote one; the prompts in its asks.json (imagegen's batch: {"name", "prompt"} or {"name", "params": {"prompt"}});
    $PCJOB_FOR (who it is for); the sender's folder and the fetch folder. Kept 3 days. Never stops a job."""
    try:
        rec = {"id": job_id, "sent": time.strftime("%Y-%m-%dT%H:%M:%S%z"), "cwd": os.getcwd(),
               "fetch": str(Path(a.fetch).expanduser().resolve()) if getattr(a, "fetch", None) else None,
               "for": os.environ.get("PCJOB_FOR") or None, "what": None}
        try:
            about = json.loads((src / "about.json").read_text(encoding="utf-8-sig"))
            if isinstance(about, dict):
                rec["what"] = str(about.get("what") or "")[:300] or None
                rec["for"] = rec["for"] or (str(about["for"])[:120] if about.get("for") else None)
        except (OSError, ValueError):
            pass
        try:
            asks = json.loads((src / "asks.json").read_text(encoding="utf-8-sig"))
        except (OSError, ValueError):
            asks = None
        if isinstance(asks, list):
            items = []
            for x in asks:
                if isinstance(x, dict):
                    pr = x.get("params") if isinstance(x.get("params"), dict) else {}
                    p = x.get("prompt") or pr.get("prompt") or pr.get("text")
                    items.append({"name": str(x.get("name") or "")[:80], "prompt": str(p)[:600] if p else None})
            rec["count"], rec["items"] = len(items), items[:40]
        SENT.mkdir(exist_ok=True)
        tmp = SENT / f"{job_id}.json.new"
        tmp.write_text(json.dumps(rec, indent=1))
        os.replace(tmp, SENT / f"{job_id}.json")
        old = time.time() - 3 * 86400
        for f in SENT.glob("*.json"):
            if f.stat().st_mtime < old:
                f.unlink(missing_ok=True)
    except Exception as e:   # a note is a nicety: report it and carry on with the job
        print(f"pcjob: could not note what {job_id} makes ({e})", file=sys.stderr)


def cmd_run(a):
    src = Path(a.dir).resolve()
    script = "job.sh" if POSIX else "job.ps1"
    if not (src / script).is_file():
        sys.exit(f"pcjob: {src}/{script} not found (this PC runs {OS_LABEL[OS_NAME]} jobs: they need a {script})")
    name = "".join(c if c.isalnum() or c in "-_" else "-" for c in (a.name or src.name))[:40]
    lane = getattr(a, "lane", None) or ""
    if lane:
        if OS_NAME != "windows":
            sys.exit(f"pcjob: --lane is for a Windows PC so far (this one runs {OS_LABEL[OS_NAME]} jobs)")
        if a.timeout is None:
            a.timeout = LANES[lane]
        if not 0 < a.timeout <= LANES[lane]:
            sys.exit(f"pcjob: a {lane} lane job runs at most {LANES[lane]} s, not {a.timeout}")
    elif a.timeout is None:
        a.timeout = 3600
    t = quiet_until()
    if t:
        print(f"pcjob: holding until {t:%H:%M} (pcjob quiet), then sending", flush=True)
        while quiet_until():
            time.sleep(30)
    wait_for_cheap(getattr(a, "cheap", False))
    job_id = time.strftime("%Y%m%d-%H%M%S-") + name
    wake()
    ok, age = runner_alive()
    if not ok:
        sys.exit(f"pcjob: the PC's job runner is not running (heartbeat age {age}s). "
                 + SETUP_HINT[OS_NAME])
    if lane:
        st = lane_state(lane)
        if st[0] == "down":   # 75: not a job failure; the caller can run the test here instead
            print(f"pcjob: {lane_line(lane, st)}; the main runner starts it within a minute "
                  "(a PC runner from before lanes: pcjob push-runner)", file=sys.stderr)
            sys.exit(75)
    with tempfile.TemporaryDirectory() as td:
        tar = Path(td) / "in.tar"
        with tarfile.open(tar, "w") as t:
            for p in sorted(src.rglob("*")):
                if p.name == ".DS_Store" or p.name.startswith("._"):
                    continue
                t.add(p, arcname=str(p.relative_to(src)), recursive=False)
        size = tar.stat().st_size
        on_pc(op_mkdir_job, job_id)
        print(f"sending {job_id} ({size / 1e6:.1f} MB)")
        scp(str(tar), f"{HOST}:{ROOT}/jobs/{job_id}/in.tar")
    on_pc(op_mark_ready, job_id, a.timeout, lane)
    note_sent(job_id, src, a)
    print(job_id)
    if a.wait or a.fetch:
        queue_max = getattr(a, "queue_max", None) or (LANES[lane] if lane else QUEUE_MAX)
        st = cmd_wait(argparse.Namespace(id=job_id, max=a.timeout + 300, queue_max=queue_max, lane=lane))
        if a.fetch:
            cmd_fetch(argparse.Namespace(id=job_id, dest=a.fetch))
        if st["state"] != "done":
            sys.exit(f"pcjob: {job_id} {st['state']}" + (f": {st['error'].strip()}" if st.get("error") else "")
                     + (f"; its logs (_log.txt, _err.txt) are in {a.fetch}" if a.fetch else ""))
    return job_id


def queue_ahead(job_id, lane=None):
    """How many queued or running jobs are ahead of job_id in its lane (each lane's runner takes the oldest first,
    one at a time). lane None: look in the main lane, then in the others."""
    for ln in ([lane] if lane is not None else ["", *LANES]):
        ahead = 0
        for line in on_pc(op_list_jobs, ln, check=False).splitlines():
            parts = line.split()
            if len(parts) == 2 and parts[1] == job_id:
                return ahead
            if len(parts) == 2 and parts[0] in ("queued", "running"):
                ahead += 1
    return 0


def patient(fn, *args):
    """fn(*args), riding out a PC that does not answer for up to WAIT_GRACE s (ssh exit 255 or no answer). Any other
    failure (quiet hold, bad id, the PC's own error) ends at once. After the grace the last failure ends the wait,
    with the same message as before, so callers that read it (refresh-kit's PC_LOST) still know the PC went away."""
    first = None
    while True:
        try:
            return fn(*args)
        except SystemExit as err:
            if not str(err.code).startswith(NO_ANSWER):
                raise
            now = time.time()
            if first is None:
                first = now
                grace = f"{WAIT_GRACE // 60} min" if WAIT_GRACE >= 60 else f"{WAIT_GRACE} s"
                print(f"pcjob: the PC did not answer ({str(err.code)[len(NO_ANSWER) + 2:][:120]}); "
                      f"trying again for up to {grace}", file=sys.stderr, flush=True)
            if now - first >= WAIT_GRACE:
                raise
            time.sleep(15)


def cmd_wait(a):
    """Waits for a job. --max limits the time it runs; the time it waits in the queue behind other jobs counts
    against --queue-max instead (default QUEUE_MAX), so a job stuck behind a long render is not given up on while
    it waits its turn (it used to be: the Mac stopped waiting, the job still ran later and nobody fetched it)."""
    ids_ok(a.id)
    queue_max = getattr(a, "queue_max", None) or QUEUE_MAX
    started = time.time()
    deadline = started + queue_max
    last = None
    while True:
        st = patient(status, a.id)
        label = st["state"]
        if label == "queued":
            label = f"queued, {patient(queue_ahead, a.id, getattr(a, 'lane', None))} job(s) ahead on the PC"
        if label != last:
            print(f"{a.id}: {label}", flush=True)
            if st["state"] == "running" and (last is None or last.startswith("queued")):
                deadline = time.time() + a.max   # the run limit starts when the job does
            last = label
        if st["state"] not in ("queued", "running", "cancelling"):   # cancelling: the runner ends it within seconds
            print(json.dumps(st, indent=1))
            if st["state"] != "done":
                print(on_pc(op_err_tail, a.id, check=False))
            return st
        if time.time() > deadline:
            limit = f"{queue_max}s in the queue" if st["state"] == "queued" else f"{a.max}s of running"
            sys.exit(f"pcjob: gave up waiting after {limit}; job still {st['state']} on the PC (pcjob status {a.id})")
        time.sleep(10)


def cmd_fetch(a):
    ids_ok(a.id)
    st = status(a.id)
    if st["state"] in ("queued", "running", "cancelling", "missing"):
        sys.exit(f"pcjob: {a.id} is {st['state']}; nothing to fetch yet")
    dest = Path(a.dest).expanduser().resolve()
    dest.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as td:
        scp(f"{HOST}:{ROOT}/jobs/{a.id}/out.tar", f"{td}/out.tar")
        for f in ("log.txt", "err.txt", "status.json"):
            subprocess.run(["scp", "-q", "-o", "BatchMode=yes", f"{HOST}:{ROOT}/jobs/{a.id}/{f}", str(dest / f"_{f}")],
                           capture_output=True)
        with tarfile.open(f"{td}/out.tar") as t:
            try:
                t.extractall(dest, filter="data")
            except TypeError:  # Python older than 3.9.17 has no filter; refuse odd paths by hand
                for m in t.getmembers():
                    if m.name.startswith(("/", "..")) or "/../" in m.name or not (m.isfile() or m.isdir()):
                        sys.exit(f"pcjob: refusing odd path in results: {m.name}")
                t.extractall(dest)
    on_pc(op_mark_fetched, a.id, check=False)   # lets pcjob prune remove the job once it is old
    print(f"results in {dest}")


def cmd_status(a):
    print(json.dumps(status(a.id), indent=1))


