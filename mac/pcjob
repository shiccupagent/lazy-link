#!/usr/bin/env python3
"""pcjob - send work to your big computer (Windows, Linux or an Apple Silicon Mac) and bring the results back.

A job is a local folder with a job.ps1 (Windows PC) or a job.sh (Linux or Mac) in it, plus any inputs.
On the PC the script runs in a copy of that folder; whatever it writes to $RENDER_OUT comes back.
$RENDER_ROOT is the PC's work folder (C:/lazylink, /srv/lazylink on Linux, or the lazylink account's
lazylink folder on a Mac). On Windows,
$env:FFMPEG and $env:BLENDER point at those tools when the PC has them. The PC's runner
(pc/runner.ps1, linux/runner.sh or macpc/runner.sh) runs it outside SSH, so closing the Mac's connection or
the Mac sleeping never kills a job.

  pcjob pair PC_ADDRESS [--os windows|linux|mac]   first time: check the PC's fingerprint, write ~/.ssh/config + config.json
  pcjob run DIR [--name N] [--timeout S] [--wait] [--fetch DEST] [--cheap]   send a job (wakes the PC)
  pcjob cheap                    the cheap-electricity hours (live prices if cheap_feed is set), and whether they're on now
  pcjob status ID | list | log ID | wait ID [--max S] [--queue-max S] | fetch ID DEST | cancel ID | rm ID
  pcjob put FILE                 copy a big input onto the PC once (prints media:<name>)
  pcjob ping | info | wake | sleep | push-runner   (sleep refuses while someone is using the PC)

Every remote step is a named operation below with two strings: the PowerShell one (Windows)
and the sh one (Linux and Mac). pc_os in config.json picks which one runs.
Settings: config.json beside this repo's README (made by `pcjob pair`; see config.example.json).
"""
import argparse, base64, hashlib, ipaddress, json, os, re, shlex, socket, subprocess, sys, tarfile, tempfile, time
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = HERE.parent
CONFIG = Path(os.environ.get("LAZY_LINK_CONFIG", REPO / "config.json"))
KEY = Path.home() / ".ssh" / "lazy-link"
KNOWN = Path.home() / ".ssh" / "known_hosts_lazy_link"
if not KEY.exists() and (Path.home() / ".ssh" / "render-link").exists():   # the name before 2026-10-29
    KEY, KNOWN = Path.home() / ".ssh" / "render-link", Path.home() / ".ssh" / "known_hosts_render_link"
CFG = json.loads(CONFIG.read_text(encoding="utf-8-sig")) if CONFIG.exists() else {}
HOST = CFG.get("ssh_host", "lazy-pc")
OS_CHOICES = ("windows", "linux", "mac")
OS_LABEL = {"windows": "Windows", "linux": "Linux", "mac": "Mac"}
PC_DIR = {"windows": "pc", "linux": "linux", "mac": "macpc"}   # this repo's folder for each OS's runner and checks
SETUP_HINT = {"windows": "Run pc/Setup-PC.cmd on the PC again.",
              "linux": "Run linux/setup-linux.sh on the PC again.",
              "mac": "Run macpc/setup-mac.sh on the Mac again (it asks for an admin password)."}
MAC_HOMES = "/Users"   # the lazylink account's home is <this>/lazylink; its work folder is <home>/lazylink
OS_NAME = CFG.get("pc_os", "windows")
if OS_NAME not in OS_CHOICES:
    sys.exit(f"pcjob: pc_os in config.json must be windows, linux or mac, not {OS_NAME!r}")


def default_root(os_name):
    return {"linux": "/srv/lazylink", "mac": MAC_HOMES + "/lazylink/lazylink"}.get(os_name, "C:/lazylink")


def default_user(os_name):
    return "lazylink"


LINUX, MAC = OS_NAME == "linux", OS_NAME == "mac"
POSIX = OS_NAME in ("linux", "mac")   # sh job scripts: Linux and Mac share them where the tools agree
ROOT = CFG.get("pc_root", default_root(OS_NAME))
SSH_USER = default_user(OS_NAME)
q = shlex.quote
SAFE_ID = re.compile(r"[A-Za-z0-9._-]{1,120}")
QUEUE_MAX = 3 * 3600   # seconds a job may wait in the PC's queue (one job at a time) before wait gives up


def set_os(os_name):
    """Switch the target OS (pair --os): the work folder and ssh user follow it."""
    global OS_NAME, LINUX, MAC, POSIX, ROOT, SSH_USER
    OS_NAME = os_name
    LINUX, MAC, POSIX = os_name == "linux", os_name == "mac", os_name in ("linux", "mac")
    ROOT = default_root(os_name)
    SSH_USER = default_user(os_name)


def stat_cmd(path, what):
    """A POSIX stat printing a file's mtime (epoch seconds) or size (bytes): GNU stat on Linux, BSD stat on a Mac."""
    if MAC:
        return f"stat -f {'%m' if what == 'mtime' else '%z'} {path}"
    return f"stat -c {'%Y' if what == 'mtime' else '%s'} {path}"


def iso_now():
    """A date-time string for the ready file: GNU date has -Iseconds, BSD date does not."""
    return "date +%Y-%m-%dT%H:%M:%S%z" if MAC else "date -Iseconds"


def need_config():
    if not CFG.get("pc_address"):
        sys.exit(f"pcjob: not paired yet ({CONFIG} missing). Run ./install-mac.sh, set up the PC, then: pcjob pair PC_ADDRESS")


def ids_ok(job_id):
    if not SAFE_ID.fullmatch(job_id or ""):
        sys.exit(f"pcjob: not a job id: {job_id!r}")
    return job_id


def ps(script, check=True, timeout=120):
    """Run a PowerShell snippet on the PC; -EncodedCommand sidesteps all quoting."""
    need_config()
    enc = base64.b64encode(script.encode("utf-16-le")).decode()
    r = subprocess.run(["ssh", "-o", "BatchMode=yes", HOST,
                        f"powershell -NoProfile -NonInteractive -EncodedCommand {enc}"],
                       capture_output=True, text=True, timeout=timeout)
    if check and r.returncode != 0:
        sys.exit(f"pcjob: PC command failed ({r.returncode}): {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout.strip()


def sh(script, check=True, timeout=120):
    """Run a POSIX sh snippet on a Linux PC over ssh (the ssh user's login shell reads it)."""
    need_config()
    r = subprocess.run(["ssh", "-o", "BatchMode=yes", HOST, script], capture_output=True, text=True, timeout=timeout)
    if check and r.returncode != 0:
        sys.exit(f"pcjob: PC command failed ({r.returncode}): {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout.strip()


def on_pc(op, *args, check=True, timeout=120):
    """One named remote operation: op(*args) gives (PowerShell, sh); this OS's string runs."""
    win, lin = op(*args)
    if POSIX:
        # the Mac's login shell is zsh, which fails on a glob with no match; /bin/sh behaves like Linux's sh here
        return sh("/bin/sh -c " + q(lin) if MAC else lin, check, timeout)
    return ps(win, check, timeout)


def scp(src, dst, timeout=3600):
    r = subprocess.run(["scp", "-q", "-o", "BatchMode=yes", src, dst], timeout=timeout)
    if r.returncode != 0:
        sys.exit(f"pcjob: copy failed: {src} -> {dst}")


def reachable():
    need_config()
    try:
        r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", HOST, "exit 0"],
                           capture_output=True, timeout=15)
        return r.returncode == 0
    except subprocess.TimeoutExpired:
        return False


def magic_packet():
    """Wake-on-LAN: 6 x 0xFF then the PC's network card address 16 times, broadcast on the home network."""
    mac = bytes.fromhex(CFG["pc_mac"].replace("-", "").replace(":", ""))
    pkt = b"\xff" * 6 + mac * 16
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for addr in CFG.get("broadcast", []) + ["255.255.255.255"]:
            for port in (9, 7):
                s.sendto(pkt, (addr, port))


def wake(max_s=120):
    """Returns True if the PC was asleep and we woke it."""
    need_config()
    if reachable():
        return False
    if not CFG.get("pc_mac"):
        sys.exit("pcjob: PC not answering, and config.json has no pc_mac to wake it with")
    print("PC not answering; sending Wake-on-LAN")
    deadline = time.time() + max_s
    while time.time() < deadline:
        magic_packet()
        if reachable():
            print("PC is awake")
            return True
        time.sleep(5)
    sys.exit(f"pcjob: PC did not wake within {max_s}s (works from sleep; not from a full shutdown with Fast Startup on)")


# ---- named remote operations: each returns (PowerShell for Windows, sh for Linux) ----

def op_heartbeat_age():
