    return (f"$b='{ROOT}/runner.heartbeat'; if (Test-Path $b) {{ [int]((Get-Date)-(Get-Item $b).LastWriteTime).TotalSeconds }} else {{ -1 }}",
            "b=" + q(b) + '; if [ -e "$b" ]; then echo $(( $(date +%s) - $(' + stat_cmd('"$b"', 'mtime') + ') )); else echo -1; fi')


