def lane_state(lane):
    """('free' | 'busy' | 'down', heartbeat age, running, queued) for a lane runner; one ssh, never wakes the PC."""
    try:
        age, running, queued = (int(x) for x in on_pc(op_lane_state, lane).split())
    except SystemExit as err:
        if not str(err.code).startswith(NO_ANSWER):
            raise
        return "down", -1, 0, 0
    state = "down" if not 0 <= age < 60 else "busy" if running or queued else "free"
    return state, age, running, queued


def lane_line(lane, st):
    state, age, running, queued = st
    if state == "down":
        return f"{lane} lane: down ({'never started' if age < 0 else f'heartbeat {age}s ago'})"
    return f"{lane} lane: {state}" + (f" ({running} running, {queued} queued)" if state == "busy" else "")


def cmd_lane(a):
    if OS_NAME != "windows":
        print(f"{a.lane} lane: down (only a Windows PC has lanes so far)")
        sys.exit(2)
    st = lane_state(a.lane)
    print(lane_line(a.lane, st))
    sys.exit({"free": 0, "busy": 1}.get(st[0], 2))


def runner_alive():
    out = on_pc(op_heartbeat_age)
    age = int(out or -1)
    return 0 <= age < 60, age


