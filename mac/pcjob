#!/usr/bin/env python3
"""pcjob - send work to your big computer (Windows, Linux or an Apple Silicon Mac) and bring the results back.

A job is a local folder with a job.ps1 (Windows PC) or a job.sh (Linux or Mac) in it, plus any inputs.
On the PC the script runs in a copy of that folder; whatever it writes to $RENDER_OUT comes back.
$RENDER_ROOT is the PC's work folder (C:/lazylink, /srv/lazylink on Linux, or the lazylink account's
lazylink folder on a Mac). On Windows,
$env:FFMPEG and $env:BLENDER point at those tools when the PC has them. The PC's runner
(pc/runner.ps1, linux/runner.sh or macpc/runner.sh) runs it outside SSH, so closing the Mac's connection or
the Mac sleeping never kills a job.

  pcjob pair PC_ADDRESS [--os windows|linux|mac]   first time: check the PC's fingerprint, write ~/.ssh/config + config.json
  pcjob run DIR [--name N] [--timeout S] [--wait] [--fetch DEST] [--cheap] [--lane test]   send a job (wakes the PC)
                                 (--lane test: a short CPU/browser job, at most 15 min, run beside the GPU job by the
                                 PC's test lane runner instead of waiting behind it; Windows PC)
  pcjob lane [test]              is that lane free? exit 0 free, 1 busy, 2 down or PC not answering, 75 quiet hold
                                 (mac/sent/<id>.json notes what it makes: the folder's about.json
                                 {"what", "for"}, its asks.json prompts, $PCJOB_FOR; for dashboards)
  pcjob cheap                    the cheap-electricity hours (live prices if cheap_feed is set), and whether they're on now
  pcjob status ID | list | log ID | wait ID [--max S] [--queue-max S] | fetch ID DEST | cancel ID | rm ID
  pcjob prune [--older-than 7d] [--legacy] [--yes]   list (with --yes: remove) finished jobs on the PC older than
                                 that whose results this Mac fetched; --legacy also counts done/failed/timeout jobs
                                 from before fetches were marked (2026-11-11) as fetched; never a cancelled or running job
  pcjob put FILE                 copy a big input onto the PC once (prints media:<name>)
  pcjob ping | info | wake | sleep | push-runner   (sleep refuses while someone is using the PC)
  pcjob quiet [HH:MM | YYYY-MM-DDTHH:MM | off]   leave the PC alone until then (an overnight hibernate): run waits,
                                 every other command that would reach the PC refuses with exit 75

Every remote step is a named operation below with two strings: the PowerShell one (Windows)
and the sh one (Linux and Mac). pc_os in config.json picks which one runs.
Settings: config.json beside this repo's README (made by `pcjob pair`; see config.example.json).
"""
import argparse, base64, hashlib, ipaddress, json, os, re, shlex, socket, subprocess, sys, tarfile, tempfile, time
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

HERE = Path(__file__).resolve().parent
REPO = HERE.parent
CONFIG = Path(os.environ.get("LAZY_LINK_CONFIG", REPO / "config.json"))
KEY = Path.home() / ".ssh" / "lazy-link"
KNOWN = Path.home() / ".ssh" / "known_hosts_lazy_link"
if not KEY.exists() and (Path.home() / ".ssh" / "render-link").exists():   # the name before 2026-10-29
    KEY, KNOWN = Path.home() / ".ssh" / "render-link", Path.home() / ".ssh" / "known_hosts_render_link"
CFG = json.loads(CONFIG.read_text(encoding="utf-8-sig")) if CONFIG.exists() else {}
HOST = CFG.get("ssh_host", "lazy-pc")
OS_CHOICES = ("windows", "linux", "mac")
OS_LABEL = {"windows": "Windows", "linux": "Linux", "mac": "Mac"}
PC_DIR = {"windows": "pc", "linux": "linux", "mac": "macpc"}   # this repo's folder for each OS's runner and checks
SETUP_HINT = {"windows": "Run pc/Setup-PC.cmd on the PC again.",
              "linux": "Run linux/setup-linux.sh on the PC again.",
              "mac": "Run macpc/setup-mac.sh on the Mac again (it asks for an admin password)."}
MAC_HOMES = "/Users"   # the lazylink account's home is <this>/lazylink; its work folder is <home>/lazylink
OS_NAME = CFG.get("pc_os", "windows")
if OS_NAME not in OS_CHOICES:
    sys.exit(f"pcjob: pc_os in config.json must be windows, linux or mac, not {OS_NAME!r}")


def default_root(os_name):
    return {"linux": "/srv/lazylink", "mac": MAC_HOMES + "/lazylink/lazylink"}.get(os_name, "C:/lazylink")


def default_user(os_name):
    return "lazylink"


LINUX, MAC = OS_NAME == "linux", OS_NAME == "mac"
POSIX = OS_NAME in ("linux", "mac")   # sh job scripts: Linux and Mac share them where the tools agree
ROOT = CFG.get("pc_root", default_root(OS_NAME))
SSH_USER = default_user(OS_NAME)
q = shlex.quote
SAFE_ID = re.compile(r"[A-Za-z0-9._-]{1,120}")
QUIET = Path(os.environ.get("LAZY_LINK_QUIET", REPO / ".quiet-until"))   # pcjob quiet: one local time, no ssh before it
LANES = {"test": 900}   # lane -> the most seconds one of its jobs may run (pc/runner.ps1 has the same table)
QUEUE_MAX = 3 * 3600   # seconds a job may wait in the PC's queue (one job at a time) before wait gives up
# seconds of unanswered status checks a wait rides out before it gives up: one ssh that timed out used to end the
# wait, and the job left on the PC was cancelled (SCZ 2026-11-06: an 80-min mesh job lost 5 times in a row)
WAIT_GRACE = int(os.environ.get("LAZY_LINK_WAIT_GRACE", 600))
NO_ANSWER = "pcjob: PC command failed (255)"


def set_os(os_name):
    """Switch the target OS (pair --os): the work folder and ssh user follow it."""
    global OS_NAME, LINUX, MAC, POSIX, ROOT, SSH_USER
    OS_NAME = os_name
    LINUX, MAC, POSIX = os_name == "linux", os_name == "mac", os_name in ("linux", "mac")
    ROOT = default_root(os_name)
    SSH_USER = default_user(os_name)


def stat_cmd(path, what):
    """A POSIX stat printing a file's mtime (epoch seconds) or size (bytes): GNU stat on Linux, BSD stat on a Mac."""
    if MAC:
        return f"stat -f {'%m' if what == 'mtime' else '%z'} {path}"
    return f"stat -c {'%Y' if what == 'mtime' else '%s'} {path}"


def iso_now():
    """A date-time string for the ready file: GNU date has -Iseconds, BSD date does not."""
    return "date +%Y-%m-%dT%H:%M:%S%z" if MAC else "date -Iseconds"


def quiet_until():
    """The end of a `pcjob quiet` hold (this computer's clock), or None. A passed or unreadable hold is no hold."""
    try:
        t = datetime.fromisoformat(QUIET.read_text().strip())
    except (OSError, ValueError):
        return None
    return t if t > datetime.now() else None


def need_config():
    # every ssh, scp and wake goes through here: even a quick check can wake a hibernating PC
    t = quiet_until()
    if t:
        print(f"pcjob: the PC is left alone until {t:%Y-%m-%d %H:%M} (pcjob quiet; `pcjob quiet off` lifts it). "
              "Try again after that.", file=sys.stderr)
        sys.exit(75)
    if not CFG.get("pc_address"):
        sys.exit(f"pcjob: not paired yet ({CONFIG} missing). Run ./install-mac.sh, set up the PC, then: pcjob pair PC_ADDRESS")


def ids_ok(job_id):
    if not SAFE_ID.fullmatch(job_id or ""):
        sys.exit(f"pcjob: not a job id: {job_id!r}")
    return job_id


def ps(script, check=True, timeout=120, stdin=None):
    """Run a PowerShell snippet on the PC; -EncodedCommand sidesteps all quoting. stdin: text the snippet reads
    with [Console]::In (how a secret travels: never in the command line, which Windows can log)."""
    need_config()
    enc = base64.b64encode(script.encode("utf-16-le")).decode()
    try:
        r = subprocess.run(["ssh", "-o", "BatchMode=yes", HOST,
                            f"powershell -NoProfile -NonInteractive -EncodedCommand {enc}"],
                           capture_output=True, text=True, timeout=timeout, input=stdin)
    except subprocess.TimeoutExpired:
        sys.exit(f"{NO_ANSWER}: ssh gave no answer in {timeout} s (Operation timed out)")
    if check and r.returncode != 0:
        sys.exit(f"pcjob: PC command failed ({r.returncode}): {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout.strip()


def sh(script, check=True, timeout=120, stdin=None):
    """Run a POSIX sh snippet on a Linux PC over ssh (the ssh user's login shell reads it)."""
    need_config()
    try:
        r = subprocess.run(["ssh", "-o", "BatchMode=yes", HOST, script], capture_output=True, text=True,
                           timeout=timeout, input=stdin)
    except subprocess.TimeoutExpired:
        sys.exit(f"{NO_ANSWER}: ssh gave no answer in {timeout} s (Operation timed out)")
    if check and r.returncode != 0:
        sys.exit(f"pcjob: PC command failed ({r.returncode}): {r.stderr.strip() or r.stdout.strip()}")
    return r.stdout.strip()


def on_pc(op, *args, check=True, timeout=120, stdin=None):
    """One named remote operation: op(*args) gives (PowerShell, sh); this OS's string runs."""
    win, lin = op(*args)
    if POSIX:
        # the Mac's login shell is zsh, which fails on a glob with no match; /bin/sh behaves like Linux's sh here
        return sh("/bin/sh -c " + q(lin) if MAC else lin, check, timeout, stdin)
    return ps(win, check, timeout, stdin)


def scp(src, dst, timeout=3600):
    r = subprocess.run(["scp", "-q", "-o", "BatchMode=yes", src, dst], timeout=timeout)
    if r.returncode != 0:
        sys.exit(f"pcjob: copy failed: {src} -> {dst}")


def reachable():
    need_config()
    try:
        r = subprocess.run(["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=5", HOST, "exit 0"],
                           capture_output=True, timeout=15)
        return r.returncode == 0
    except subprocess.TimeoutExpired:
        return False


def magic_packet():
    """Wake-on-LAN: 6 x 0xFF then the PC's network card address 16 times, broadcast on the home network."""
    mac = bytes.fromhex(CFG["pc_mac"].replace("-", "").replace(":", ""))
    pkt = b"\xff" * 6 + mac * 16
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as s:
        s.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for addr in CFG.get("broadcast", []) + ["255.255.255.255"]:
            for port in (9, 7):
                s.sendto(pkt, (addr, port))


def wake(max_s=120):
    """Returns True if the PC was asleep and we woke it."""
    need_config()
    if reachable():
        return False
    if not CFG.get("pc_mac"):
        sys.exit("pcjob: PC not answering, and config.json has no pc_mac to wake it with")
    print("PC not answering; sending Wake-on-LAN")
    deadline = time.time() + max_s
    while time.time() < deadline:
        magic_packet()
        if reachable():
            print("PC is awake")
            return True
        time.sleep(5)
    sys.exit(f"pcjob: PC did not wake within {max_s}s (works from sleep; not from a full shutdown with Fast Startup on)")


# ---- named remote operations: each returns (PowerShell for Windows, sh for Linux) ----

def op_heartbeat_age():
    b = ROOT + "/runner.heartbeat"
    return (f"$b='{ROOT}/runner.heartbeat'; if (Test-Path $b) {{ [int]((Get-Date)-(Get-Item $b).LastWriteTime).TotalSeconds }} else {{ -1 }}",
            "b=" + q(b) + '; if [ -e "$b" ]; then echo $(( $(date +%s) - $(' + stat_cmd('"$b"', 'mtime') + ') )); else echo -1; fi')


def op_status(job_id):
    d = ROOT + "/jobs/" + job_id
    return (f"$f='{ROOT}/jobs/{job_id}/status.json'; if (Test-Path $f) {{ Get-Content $f -Raw }} "
            f"elseif (Test-Path '{ROOT}/jobs/{job_id}/cancel') {{ '{{\"state\":\"cancelling\"}}' }} "
            f"elseif (Test-Path '{ROOT}/jobs/{job_id}/ready') {{ '{{\"state\":\"queued\"}}' }} else {{ '{{\"state\":\"missing\"}}' }}",
            "d=" + q(d) + '; if [ -f "$d/status.json" ]; then cat "$d/status.json"; '
            'elif [ -f "$d/cancel" ]; then echo \'{"state":"cancelling"}\'; '
            'elif [ -f "$d/ready" ]; then echo \'{"state":"queued"}\'; else echo \'{"state":"missing"}\'; fi')


def op_mkdir_job(job_id):
    return (f"New-Item -ItemType Directory -Force '{ROOT}/jobs/{job_id}' | Out-Null",
            "mkdir -p " + q(ROOT + "/jobs/" + job_id))


def op_mark_ready(job_id, timeout_s, lane=""):
    js = json.dumps({"timeout_s": timeout_s, **({"lane": lane} if lane else {})})
    d = ROOT + "/jobs/" + job_id
    # the lane file goes before 'ready': the runners pick a job by its lane the moment 'ready' appears
    return ((f"Set-Content '{ROOT}/jobs/{job_id}/lane' '{lane}'; " if lane else "") +
            f"Set-Content '{ROOT}/jobs/{job_id}/job.json' '{js}'; "
            f"Set-Content '{ROOT}/jobs/{job_id}/ready' (Get-Date -Format o)",
            ("printf '%s\\n' " + q(lane) + " > " + q(d + "/lane") + " && " if lane else "") +
            "printf '%s\\n' " + q(js) + " > " + q(d + "/job.json") + " && " + iso_now() + " > " + q(d + "/ready"))


def op_lane_state(lane):
    """'heartbeat_age running queued' for one lane runner, in one call (age -1: it has never run)."""
    return (f"$b='{ROOT}/runner-{lane}.heartbeat'; "
            "$age = if (Test-Path $b) { [int]((Get-Date)-(Get-Item $b).LastWriteTime).TotalSeconds } else { -1 }; "
            f"$r = 0; $n = 0; Get-ChildItem '{ROOT}/jobs' -Directory | ForEach-Object {{ " + PS_LANE +
            f"if ($ln -ne '{lane}' -or -not (Test-Path (Join-Path $_.FullName 'ready'))) {{ return }}; "
            "$s = Join-Path $_.FullName 'status.json'; "
            "if (Test-Path $s) { if ((Get-Content $s -Raw | ConvertFrom-Json).state -eq 'running') { $r++ } } "
            "elseif (-not (Test-Path (Join-Path $_.FullName 'cancel'))) { $n++ } }; \"$age $r $n\"",
            "echo -1 0 0")   # Linux and Mac PCs have no lane runner yet


PS_LANE = ("$lf = Join-Path $_.FullName 'lane'; "
           "$ln = if (Test-Path $lf) { ([string](Get-Content $lf -TotalCount 1)).Trim() } else { '' }; ")
SH_LANE = 'ln=; [ -f "$d/lane" ] && ln=$(head -n 1 "$d/lane"); '


def op_list_jobs(lane=""):
    """'state id' per job of one lane ('' = the main runner's), oldest first."""
    return (f"Get-ChildItem '{ROOT}/jobs' -Directory | Sort-Object CreationTime | ForEach-Object {{ " + PS_LANE +
            f"if ($ln -ne '{lane}') {{ return }}; "
            "$s = Join-Path $_.FullName 'status.json'; "
            "$st = if (Test-Path $s) { (Get-Content $s -Raw | ConvertFrom-Json).state } "
            "elseif (Test-Path (Join-Path $_.FullName 'cancel')) { 'cancelling' } else { 'queued' }; "
            "'{0,-10} {1}' -f $st, $_.Name }",
            "cd " + q(ROOT + "/jobs") + " 2>/dev/null || exit 0; for d in *; do [ -d \"$d\" ] || continue; "
            + SH_LANE + "[ \"$ln\" = " + q(lane) + " ] || continue; "
            "st=queued; if [ -f \"$d/status.json\" ]; then st=$(sed -n 's/.*\"state\": *\"\\([a-z]*\\)\".*/\\1/p' \"$d/status.json\"); "
            "elif [ -f \"$d/cancel\" ]; then st=cancelling; fi; "
            "printf '%-10s %s\\n' \"$st\" \"$d\"; done")


def op_log(job_id):
    d = ROOT + "/jobs/" + job_id
    return (f"Get-Content '{ROOT}/jobs/{job_id}/log.txt' -Tail 40 -ErrorAction SilentlyContinue; '--- err'; "
            f"Get-Content '{ROOT}/jobs/{job_id}/err.txt' -Tail 20 -ErrorAction SilentlyContinue",
            "tail -n 40 " + q(d + "/log.txt") + " 2>/dev/null; echo '--- err'; tail -n 20 " + q(d + "/err.txt") + " 2>/dev/null; true")


def op_err_tail(job_id):
    d = ROOT + "/jobs/" + job_id
    return (f"Get-Content '{ROOT}/jobs/{job_id}/err.txt' -Tail 20 -ErrorAction SilentlyContinue",
            "tail -n 20 " + q(d + "/err.txt") + " 2>/dev/null; true")


SECRET_NAME = re.compile(r"^[A-Z][A-Z0-9_]{1,40}$")


def op_put_secret(name):
    """The value arrives on stdin, never in the command. The folder is readable by the job account only
    (Windows: inheritance off, one grant; POSIX: mode 700), and the job that needs it deletes it on reading."""
    d = ROOT + "/secrets"
    return (f"$d='{d}'; New-Item -ItemType Directory -Force $d | Out-Null; "
            f"icacls $d /inheritance:r /grant:r \"$($env:USERNAME):(OI)(CI)F\" | Out-Null; "
            f"$v=[Console]::In.ReadToEnd().Trim(); if (-not $v) {{ throw 'no value on stdin' }}; "
            f"[IO.File]::WriteAllText('{d}/{name}', $v); 'saved'",
            "umask 077; mkdir -p " + q(d) + " && chmod 700 " + q(d) + " && cat > " + q(d + "/" + name)
            + " && [ -s " + q(d + "/" + name) + " ] && echo saved")


def op_drop_secret(name):
    p = ROOT + "/secrets/" + name
    return (f"Remove-Item -Force -ErrorAction SilentlyContinue '{p}'; if (Test-Path '{p}') {{ 'still there' }} else {{ 'gone' }}",
            "rm -f " + q(p) + "; [ -e " + q(p) + " ] && echo 'still there' || echo gone")


def op_has_secret(name):
    p = ROOT + "/secrets/" + name
    return (f"if (Test-Path '{p}') {{ 'yes' }} else {{ 'no' }}", "[ -e " + q(p) + " ] && echo yes || echo no")


def put_secret(name):
    """Copy the environment variable NAME (set by a key manager, e.g. `keydrop run NAME -- ...`) to the PC
    for one job. Its value is never printed, put on a command line or written to the job folder."""
    if not SECRET_NAME.match(name):
        sys.exit(f"pcjob: secret names are like HF_TOKEN (got {name!r})")
    v = os.environ.get(name, "").strip()
    if not v:
        sys.exit(f"pcjob: {name} is not set; run this through your key manager, e.g. keydrop run {name} -- ...")
    out = on_pc(op_put_secret, name, stdin=v + "\n")
    if out.strip() != "saved":
        sys.exit(f"pcjob: could not save {name} on the PC")


def drop_secret(name):
    if on_pc(op_drop_secret, name, check=False).strip() != "gone":
        print(f"pcjob: WARNING: {name} may still be on the PC in secrets/; run: pcjob secret drop {name}", file=sys.stderr)


def cmd_secret(a):
    if a.action == "put":
        put_secret(a.name); print(f"{a.name} is on the PC for the next job that needs it (it deletes it on reading)")
    elif a.action == "drop":
        drop_secret(a.name); print(f"{a.name} removed from the PC")
    else:
        has = on_pc(op_has_secret, a.name).strip() == "yes"
        print(f"{a.name}: {'on the PC' if has else 'not on the PC'}")
        sys.exit(0 if has else 1)


def op_cancel(job_id):
    return (f"Set-Content '{ROOT}/jobs/{job_id}/cancel' x",
            "echo x > " + q(ROOT + "/jobs/" + job_id + "/cancel"))


def op_mark_fetched(job_id):
    """A 'fetched' file in the job folder: the Mac has the results, so pcjob prune may remove the job later."""
    return (f"Set-Content '{ROOT}/jobs/{job_id}/fetched' (Get-Date -Format o)",
            "date > " + q(ROOT + "/jobs/" + job_id + "/fetched"))


def op_prune_list():
    """One line per job folder: id, state, days since it last changed, bytes, fetched (1/0)."""
    return (f"$now = Get-Date; Get-ChildItem '{ROOT}/jobs' -Directory | ForEach-Object {{ "
            "$s = 'missing'; $f = Join-Path $_.FullName 'status.json'; "
            "if (Test-Path $f) { try { $s = (Get-Content $f -Raw | ConvertFrom-Json).state } catch { $s = 'unreadable' }; "
            "$t = (Get-Item $f).LastWriteTime } else { $t = $_.LastWriteTime }; "
            "$b = (Get-ChildItem $_.FullName -Recurse -File -Force -ErrorAction SilentlyContinue | Measure-Object Length -Sum).Sum; "
            "if (-not $b) { $b = 0 }; "
            "$fe = if (Test-Path (Join-Path $_.FullName 'fetched')) { 1 } else { 0 }; "
            "\"$($_.Name)`t$s`t$([int]($now - $t).TotalDays)`t$b`t$fe\" }",
            "cd " + q(ROOT + "/jobs") + " 2>/dev/null || exit 0; now=$(date +%s); for d in *; do [ -d \"$d\" ] || continue; "
            "st=missing; t=$(stat -c %Y \"$d\" 2>/dev/null || stat -f %m \"$d\"); "
            "if [ -f \"$d/status.json\" ]; then st=$(sed -n 's/.*\"state\": *\"\\([a-z]*\\)\".*/\\1/p' \"$d/status.json\" | head -n 1); "
            "t=$(stat -c %Y \"$d/status.json\" 2>/dev/null || stat -f %m \"$d/status.json\"); fi; "
            "b=$(du -sk \"$d\" | cut -f1); fe=0; [ -f \"$d/fetched\" ] && fe=1; "
            "printf '%s\\t%s\\t%s\\t%s\\t%s\\n' \"$d\" \"${st:-missing}\" $(( (now - t) / 86400 )) $((b * 1024)) $fe; done")


def op_remove_job(job_id):
    return (f"Remove-Item '{ROOT}/jobs/{job_id}' -Recurse -Force",
            "rm -rf " + q(ROOT + "/jobs/" + job_id))


def op_media_size(name):
    f = ROOT + "/media/" + name
    return (f"$f='{ROOT}/media/{name}'; if (Test-Path $f) {{ (Get-Item $f).Length }} else {{ -1 }}",
            "f=" + q(f) + '; if [ -f "$f" ]; then ' + stat_cmd('"$f"', 'size') + '; else echo -1; fi')


def op_mkdir_media():
    return (f"New-Item -ItemType Directory -Force '{ROOT}/media' | Out-Null",
            "mkdir -p " + q(ROOT + "/media"))


def op_move_media(name):
    return (f"Move-Item '{ROOT}/media/{name}.part' '{ROOT}/media/{name}' -Force",
            "mv -f " + q(ROOT + "/media/" + name + ".part") + " " + q(ROOT + "/media/" + name))


def op_has_media(name):
    p = ROOT + "/media/" + name
    return (f"Test-Path '{ROOT}/media/{name}'",
            "if [ -e " + q(p) + " ]; then echo True; else echo False; fi")


def op_in_use():
    # Someone is "using" the PC when a real user is signed in and active. The lazylink account and the
    # service never count. Output: "<in use 0|1> <at lock screen 0|1>"; on Windows it's the desktop check.
    lin = ("e=0; for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do "
           "a=$(loginctl show-session \"$s\" -p Active --value); c=$(loginctl show-session \"$s\" -p Class --value); "
           "t=$(loginctl show-session \"$s\" -p Type --value); "
           "if [ \"$a\" = yes ] && [ \"$c\" = user ] && { [ \"$t\" = x11 ] || [ \"$t\" = wayland ] || [ \"$t\" = tty ]; }; "
           "then e=1; fi; done; echo \"$e 0\"")
    # Mac: the console owner is a real user (not root, lazylink, render or a system _account), and either the
    # keyboard/mouse was used in the last 15 minutes or an app is holding the display awake.
    # If the idle time can't be read, the Mac counts as in use (sleep is refused, which is the safe side).
    mac = ("e=0; u=$(stat -f %Su /dev/console 2>/dev/null); "
           "case \"$u\" in ''|root|lazylink|render|_*) ;; *) "
           "ns=$(ioreg -c IOHIDSystem 2>/dev/null | awk '/HIDIdleTime/ {print $NF; exit}'); "
           "idle=$(( ${ns:-0} / 1000000000 )); "
           "if [ \"$idle\" -lt 900 ] || pmset -g assertions 2>/dev/null | grep -q PreventUserIdleDisplaySleep; then e=1; fi;; esac; "
           "echo \"$e 0\"")
    return ("$e = @(Get-Process explorer -EA SilentlyContinue | Where-Object SessionId -gt 0).Count; "
            "$l = @(Get-Process LogonUI -EA SilentlyContinue).Count; \"$e $l\"", mac if MAC else lin)


def op_busy_jobs():
    return (f"@(Get-ChildItem '{ROOT}/jobs' -Directory | Where-Object {{ $s = Join-Path $_.FullName 'status.json'; "
            "(Test-Path (Join-Path $_.FullName 'ready')) -and ((-not (Test-Path $s) -and -not (Test-Path (Join-Path $_.FullName 'cancel'))) "
            "-or ((Test-Path $s) -and (Get-Content $s -Raw | ConvertFrom-Json).state -eq 'running')) }).Count",
            "n=0; for d in " + q(ROOT + "/jobs") + "/*; do [ -f \"$d/ready\" ] || continue; "
            "if { [ ! -f \"$d/status.json\" ] && [ ! -f \"$d/cancel\" ]; } || grep -q '\"state\": *\"running\"' \"$d/status.json\" 2>/dev/null; "
            "then n=$((n+1)); fi; done; echo $n")


def op_sleep(hib):
    script = ("Add-Type -Namespace RL -Name Pwr -MemberDefinition '[DllImport(\"powrprof.dll\")] "
              "public static extern bool SetSuspendState(bool h, bool f, bool d);'; [void][RL.Pwr]::SetSuspendState($" + ("true" if hib else "false") + ", $false, $false)")
    # Linux: the sudoers line from setup-linux.sh allows exactly this command, and nothing else.
    # Mac: the sudoers line from setup-mac.sh allows exactly "pmset sleepnow", and nothing else.
    return (script, "sudo -n /usr/bin/pmset sleepnow" if MAC else "sudo -n systemctl suspend")


