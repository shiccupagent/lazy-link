# ---- live prices: "cheap_feed" in config.json picks the cheapest hours of each day from a free public feed ----
# ComEd (Northern Illinois, USA), checked 2026-10-30:
#   https://hourlypricing.comed.com/api?type=daynexttomorrow&format=json  tomorrow's day-ahead, [] until published
#   https://hourlypricing.comed.com/api?type=5minutefeed&format=json      the last 24 h, 5-minute slots (guess when day-ahead is empty)
#   rows are {"millisUTC": "...", "price": "3.0"} in cents/kWh
# Octopus Energy Agile (UK), checked 2026-10-30, no key:
#   https://api.octopus.energy/v1/products/?is_variable=true              the product list; the Agile code changes, so pick the newest open one
#   https://api.octopus.energy/v1/products/<CODE>/electricity-tariffs/E-1R-<CODE>-<REGION>/standard-unit-rates/?period_from=..&period_to=..
#   half-hourly rows {"valid_from", "valid_to", "value_inc_vat"} in pence/kWh, newest first, paged with "next"
COMED_API = "https://hourlypricing.comed.com/api"
OCTOPUS_API = "https://api.octopus.energy/v1"
CHEAP_FEED = CFG.get("cheap_feed") or None
CHEAP_FEED_HOURS = CFG.get("cheap_feed_hours", 6)
CHEAP_CACHE = CONFIG.with_name(".cheap-feed-cache.json")
FEED_TIMEOUT_S = 10
FEED_MAX_AGE_S = 3 * 3600      # refetch at least this often
FEED_COVER_S = 12 * 3600       # the prices should reach this far ahead
FEED_RETRY_S = 30 * 60         # after a failure, or a feed that ends too soon, wait this long before asking again
_feed_retry_at = 0.0
if CHEAP_FEED is not None:
    if not isinstance(CHEAP_FEED, dict) or CHEAP_FEED.get("source") not in ("comed", "octopus") or \
            (CHEAP_FEED.get("source") == "octopus" and not re.fullmatch(r"[A-Za-z]", str(CHEAP_FEED.get("region", "")))):
        sys.exit('pcjob: cheap_feed in config.json must be {"source": "comed"} or {"source": "octopus", "region": "C"}')
    if not isinstance(CHEAP_FEED_HOURS, int) or isinstance(CHEAP_FEED_HOURS, bool) or not 1 <= CHEAP_FEED_HOURS <= 24:
        sys.exit("pcjob: cheap_feed_hours in config.json must be a whole number from 1 to 24")


def _get_json(url):
    req = urllib.request.Request(url, headers={"User-Agent": "lazy-link-pcjob"})
    with urllib.request.urlopen(req, timeout=FEED_TIMEOUT_S) as r:
        return json.loads(r.read().decode("utf-8-sig"))


def _utc(t):
    return datetime.fromtimestamp(t, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def _iso_epoch(s):
    return datetime.fromisoformat(s.replace("Z", "+00:00")).timestamp()


def _hour_start(t):
    """The start of the local hour that contains epoch time t."""
    return int(datetime.fromtimestamp(t).replace(minute=0, second=0, microsecond=0).timestamp())


def _octopus_pages(url):
    while url:
        d = _get_json(url)
        yield from d["results"]
        url = d.get("next")


def _comed_slots():
    day_ahead = [(int(r["millisUTC"]) / 1000, float(r["price"]))
                 for r in _get_json(f"{COMED_API}?type=daynexttomorrow&format=json")]
    if day_ahead:
        return day_ahead, "ComEd day-ahead prices"
    # not published yet: the last 24 h, moved on by one day, is the guess for the next 24 h
    last_day = [(int(r["millisUTC"]) / 1000 + 86400, float(r["price"]))
                for r in _get_json(f"{COMED_API}?type=5minutefeed&format=json")]
    return last_day, "ComEd last day's prices (day-ahead not out yet)"


def _octopus_slots(region):
    agile = [p for p in _octopus_pages(f"{OCTOPUS_API}/products/?is_variable=true")
             if p["code"].startswith("AGILE-") and "OUTGOING" not in p["code"]
             and p.get("direction") == "IMPORT" and not p.get("available_to")]
    if not agile:
        raise ValueError("no open Agile import tariff on the Octopus product list")
    code = max(agile, key=lambda p: _iso_epoch(p["available_from"]))["code"]
    start = int(time.time() // 3600) * 3600
    url = (f"{OCTOPUS_API}/products/{code}/electricity-tariffs/E-1R-{code}-{region}/standard-unit-rates/"
           f"?period_from={_utc(start)}&period_to={_utc(start + 86400)}&page_size=100")
    slots = [(_iso_epoch(r["valid_from"]), float(r["value_inc_vat"])) for r in _octopus_pages(url)]
    return slots, f"Octopus Agile {code} (region {region})"


def _pick(slots, now, n):
    """Average the prices into whole local hours, keep the next 24 h, take the n cheapest hours.
    Returns ([[start, end], ...] epoch windows in time order, when the prices run out)."""
    by_hour = {}
    for t, price in slots:
        by_hour.setdefault(_hour_start(t), []).append(price)
    if not by_hour:
        raise ValueError("the feed had no prices")
    first = _hour_start(now)
    avg = {h: sum(v) / len(v) for h, v in by_hour.items() if first <= h < now + 86400}
    if not avg:
        raise ValueError("the feed had no prices for the next 24 h")
    spans = []
    for h in sorted(sorted(avg, key=avg.get)[:n]):
        if spans and spans[-1][1] == h:
            spans[-1][1] = h + 3600
        else:
            spans.append([h, h + 3600])
    return spans, max(by_hour) + 3600


def _clock_min(t):
    lt = time.localtime(t)
    return lt.tm_hour * 60 + lt.tm_min


def _feed_key():
    return json.dumps([CHEAP_FEED, CHEAP_FEED_HOURS], sort_keys=True)


def _read_cache():
    try:
        c = json.loads(CHEAP_CACHE.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    ok = isinstance(c, dict) and c.get("key") == _feed_key() and all(k in c for k in ("fetched_at", "covers_until", "label", "windows"))
    return c if ok else None


def _fetch_plan(now):
    src = CHEAP_FEED["source"]
    if src == "comed":
        slots, label = _comed_slots()
    else:
        slots, label = _octopus_slots(CHEAP_FEED["region"].upper())
    spans, covers = _pick(slots, now, CHEAP_FEED_HOURS)
    return {"key": _feed_key(), "fetched_at": int(now), "covers_until": covers, "label": label,
            "windows": [[_clock_min(a) % 1440, _clock_min(b) % 1440] for a, b in spans]}


def cheap_feed_plan(now=None):
    """The live feed's plan ({"label", "windows", ...}), or None when the feed is off or down.
    Uses the cache file while it is fresh; asks the feed at most once per FEED_RETRY_S. Never raises."""
    global _feed_retry_at
    now = time.time() if now is None else now
    c = _read_cache()
    if c and now - c["fetched_at"] < FEED_MAX_AGE_S and (c["covers_until"] >= now + FEED_COVER_S or now - c["fetched_at"] < FEED_RETRY_S):
        return c
    if now < _feed_retry_at:
        return None
    try:
        plan = _fetch_plan(now)
    except Exception as e:   # any trouble with the feed: fall back, never crash a job
        _feed_retry_at = now + FEED_RETRY_S
        fallback = "cheap_hours instead" if CFG.get("cheap_hours") else "no cheap_hours fallback set"
        print(f"pcjob: live price feed unavailable ({e.__class__.__name__}: {e}); using {fallback}", file=sys.stderr, flush=True)
        return None
    try:
        CHEAP_CACHE.write_text(json.dumps(plan) + "\n", encoding="utf-8")
    except OSError:
        pass
    return plan


def span_text(ws):
    return ", ".join(f"{a // 60:02d}:{a % 60:02d}-{b // 60:02d}:{b % 60:02d}" for a, b in ws)


def fixed_windows():
    """config.json "cheap_hours": ["23:00-07:00", ...] (this computer's clock) -> [(start_min, end_min)]."""
    out = []
    for w in CFG.get("cheap_hours") or []:
        a, b = (int(h) * 60 + int(m) for h, m in (x.strip().split(":") for x in w.split("-")))
        out.append((a, b))
    return out


def cheap_source():
    """(label, [(start_min, end_min)]) for the hours in use: the live feed when it works, else cheap_hours.
    The label is None when neither gives any hours."""
    plan = cheap_feed_plan() if CHEAP_FEED else None
    if plan:
        return plan["label"], [tuple(w) for w in plan["windows"]]
    ws = fixed_windows()
    return ("cheap_hours" if ws else None), ws


def windows():
    """The cheap hours as [(start_min, end_min)] on this computer's clock (a window may wrap past midnight)."""
    return cheap_source()[1]


def minutes_to_cheap(now=None):
    """0 inside a cheap window, else minutes until the next one starts; None when no windows are set."""
    ws = windows()
    if not ws:
        return None
    t = time.localtime(now)
    m = t.tm_hour * 60 + t.tm_min
    if any((a <= m < b) if a < b else (m >= a or m < b) for a, b in ws):
        return 0
    return min((a - m) % 1440 for a, _ in ws)


def wait_for_cheap(force=False):
    """Hold a heavy job until electricity is cheap: with --cheap, LAZY_CHEAP=1, or "cheap_only": true in config.json."""
    if not (force or CFG.get("cheap_only") or os.environ.get("LAZY_CHEAP") == "1"):
        return
    label, ws = cheap_source()
    if not ws and not CHEAP_FEED:
        sys.exit("pcjob: --cheap needs \"cheap_hours\" or \"cheap_feed\" in config.json, e.g. [\"23:00-07:00\"] (see config.example.json)")
    left = minutes_to_cheap()
    if left is None:   # the live feed is down and there is no cheap_hours fallback: keep waiting, retry later
        print("pcjob: waiting: the live price feed is down and no cheap_hours fallback is set; retrying", flush=True)
    elif left:
        print(f"pcjob: waiting for cheap electricity: starts in {left // 60} h {left % 60:02d} min "
              f"({label}: {span_text(ws)})", flush=True)
    while minutes_to_cheap() != 0:
        time.sleep(30)


def cmd_run(a):
    src = Path(a.dir).resolve()
    script = "job.sh" if POSIX else "job.ps1"
    if not (src / script).is_file():
        sys.exit(f"pcjob: {src}/{script} not found (this PC runs {OS_LABEL[OS_NAME]} jobs: they need a {script})")
    name = "".join(c if c.isalnum() or c in "-_" else "-" for c in (a.name or src.name))[:40]
    wait_for_cheap(getattr(a, "cheap", False))
    job_id = time.strftime("%Y%m%d-%H%M%S-") + name
    wake()
    ok, age = runner_alive()
    if not ok:
        sys.exit(f"pcjob: the PC's job runner is not running (heartbeat age {age}s). "
                 + SETUP_HINT[OS_NAME])
    with tempfile.TemporaryDirectory() as td:
        tar = Path(td) / "in.tar"
        with tarfile.open(tar, "w") as t:
            for p in sorted(src.rglob("*")):
                if p.name == ".DS_Store" or p.name.startswith("._"):
                    continue
                t.add(p, arcname=str(p.relative_to(src)), recursive=False)
        size = tar.stat().st_size
        on_pc(op_mkdir_job, job_id)
        print(f"sending {job_id} ({size / 1e6:.1f} MB)")
        scp(str(tar), f"{HOST}:{ROOT}/jobs/{job_id}/in.tar")
    on_pc(op_mark_ready, job_id, a.timeout)
    print(job_id)
    if a.wait or a.fetch:
        st = cmd_wait(argparse.Namespace(id=job_id, max=a.timeout + 300, queue_max=getattr(a, "queue_max", QUEUE_MAX)))
        if a.fetch:
            cmd_fetch(argparse.Namespace(id=job_id, dest=a.fetch))
        if st["state"] != "done":
            sys.exit(f"pcjob: {job_id} {st['state']}" + (f": {st['error'].strip()}" if st.get("error") else "")
                     + (f"; its logs (_log.txt, _err.txt) are in {a.fetch}" if a.fetch else ""))
    return job_id


def queue_ahead(job_id):
    """How many queued or running jobs are ahead of job_id (the runner takes the oldest first, one at a time)."""
    ahead = 0
    for line in on_pc(op_list_jobs, check=False).splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1] == job_id:
            return ahead
        if len(parts) == 2 and parts[0] in ("queued", "running"):
            ahead += 1
    return ahead


def cmd_wait(a):
    """Waits for a job. --max limits the time it runs; the time it waits in the queue behind other jobs counts
    against --queue-max instead (default QUEUE_MAX), so a job stuck behind a long render is not given up on while
    it waits its turn (it used to be: the Mac stopped waiting, the job still ran later and nobody fetched it)."""
    ids_ok(a.id)
    queue_max = getattr(a, "queue_max", None) or QUEUE_MAX
    started = time.time()
    deadline = started + queue_max
    last = None
    while True:
        st = status(a.id)
        label = st["state"]
        if label == "queued":
            label = f"queued, {queue_ahead(a.id)} job(s) ahead on the PC"
        if label != last:
            print(f"{a.id}: {label}", flush=True)
            if st["state"] == "running" and (last is None or last.startswith("queued")):
                deadline = time.time() + a.max   # the run limit starts when the job does
            last = label
        if st["state"] not in ("queued", "running"):
            print(json.dumps(st, indent=1))
            if st["state"] != "done":
                print(on_pc(op_err_tail, a.id, check=False))
            return st
        if time.time() > deadline:
            limit = f"{queue_max}s in the queue" if st["state"] == "queued" else f"{a.max}s of running"
            sys.exit(f"pcjob: gave up waiting after {limit}; job still {st['state']} on the PC (pcjob status {a.id})")
        time.sleep(10)


def cmd_fetch(a):
    ids_ok(a.id)
    st = status(a.id)
    if st["state"] in ("queued", "running", "missing"):
        sys.exit(f"pcjob: {a.id} is {st['state']}; nothing to fetch yet")
    dest = Path(a.dest).expanduser().resolve()
    dest.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory() as td:
        scp(f"{HOST}:{ROOT}/jobs/{a.id}/out.tar", f"{td}/out.tar")
        for f in ("log.txt", "err.txt", "status.json"):
            subprocess.run(["scp", "-q", "-o", "BatchMode=yes", f"{HOST}:{ROOT}/jobs/{a.id}/{f}", str(dest / f"_{f}")],
                           capture_output=True)
        with tarfile.open(f"{td}/out.tar") as t:
            try:
                t.extractall(dest, filter="data")
            except TypeError:  # Python older than 3.9.17 has no filter; refuse odd paths by hand
                for m in t.getmembers():
                    if m.name.startswith(("/", "..")) or "/../" in m.name or not (m.isfile() or m.isdir()):
                        sys.exit(f"pcjob: refusing odd path in results: {m.name}")
                t.extractall(dest)
    print(f"results in {dest}")


def cmd_status(a):
    print(json.dumps(status(a.id), indent=1))


def cmd_list(a):
    print(on_pc(op_list_jobs))
    ok, age = runner_alive()
    print(f"runner: {'up' if ok else 'DOWN'} (heartbeat {age}s ago)")


def cmd_log(a):
    ids_ok(a.id)
    print(on_pc(op_log, a.id, check=False))


def cmd_cancel(a):
    ids_ok(a.id)
    on_pc(op_cancel, a.id)
    print(f"cancel requested for {a.id}")


def cmd_rm(a):
    ids_ok(a.id)
    st = status(a.id)
    if st["state"] == "running":
        sys.exit("pcjob: job is running; cancel it first")
    on_pc(op_remove_job, a.id)
    print(f"removed {a.id} from the PC")


def put(path):
    """Copy a file into C:/lazylink/media once; the name carries a content hash, so the same
    footage is never sent twice and two different files never share a name."""
    path = Path(path).expanduser().resolve()
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    stem = "".join(c if c.isalnum() or c in "-_" else "-" for c in path.stem)[:40]
    name = f"{h.hexdigest()[:12]}-{stem}{path.suffix.lower()}"
    size = path.stat().st_size
    have = on_pc(op_media_size, name)
    if int(have or -1) != size:
        on_pc(op_mkdir_media)
        print(f"uploading {path.name} ({size / 1e6:.0f} MB)", file=sys.stderr)
        scp(str(path), f"{HOST}:{ROOT}/media/{name}.part")
        on_pc(op_move_media, name)
    return f"media:{name}"


def has_media(ref):
    name = ref[len("media:"):]
    return on_pc(op_has_media, name) == "True"


def cmd_put(a):
    wake()
    print(put(a.file))


def in_use():
    """Is someone on the PC? Signed in (a desktop in a user session) and not at the lock screen.
    (lazylink can't see their idle time, so an unlocked desktop counts as in use.)"""
    out = on_pc(op_in_use)
    e, l = (int(x) for x in out.split())
    return e > 0 and l == 0


def release(woke):
    """After a job: put the PC back to sleep only if we woke it and nobody is using it."""
    if not woke:
        return
    if in_use():
        print("leaving the PC on: someone is signed in and using it")
        return
    cmd_sleep(argparse.Namespace(hibernate=False, nobody_there=False))   # sleep, not hibernate: see docs/TROUBLESHOOTING.md


def cmd_sleep(a):
    hib = bool(a and a.hibernate)
    if hib and OS_NAME != "windows":
        sys.exit("pcjob: hibernate is a Windows option; a Linux or Mac PC sleeps with: pcjob sleep")
    if in_use() and not (a and a.nobody_there):
        sys.exit("pcjob: someone is signed in and using the PC (unlocked); not putting it to sleep")
    busy = on_pc(op_busy_jobs)
    if busy != "0":
        sys.exit(f"pcjob: {busy} job(s) queued or running; not putting the PC to sleep")
    try:  # the PC drops the link as it sleeps, so this call never returns cleanly
        on_pc(op_sleep, hib, check=False, timeout=20)
    except subprocess.TimeoutExpired:
        pass
    # hibernate writes memory to disk first; a check that arrives meanwhile can cancel it
    time.sleep(60 if hib else 5)
    state = "hibernating (fully off, no sleep light)" if hib else "asleep"
    print(f"PC is {state}" if not reachable() else "pcjob: PC still answering; it did not sleep")


def cmd_push_runner(a):
    f = "runner.ps1" if OS_NAME == "windows" else "runner.sh"
    on_pc(op_mkdir_runner)
    # copy then move, so a running runner never sees a half-written file
    scp(str(REPO / PC_DIR[OS_NAME] / f), f"{HOST}:{ROOT}/runner/{f}.new")
    on_pc(op_move_runner, f)
    print("runner pushed (a running runner restarts itself on the new copy)")


def cmd_info(a):
    print(on_pc(op_info))


def cmd_pair(a):
    """First contact: show the PC's SSH fingerprint (compare it with the PC's screen), then write an
    ~/.ssh/config entry that only ever uses our own key and our own pinned host key."""
    if a.os and a.os != OS_NAME:
        set_os(a.os)
    if not KEY.exists():
        sys.exit("pcjob: no Mac key yet; run ./install-mac.sh first")
    scan = subprocess.run(["ssh-keyscan", "-T", "8", "-t", "ed25519", a.address], capture_output=True, text=True)
    line = next((l for l in scan.stdout.splitlines() if " ssh-ed25519 " in l), None)
    if not line:
        sys.exit(f"pcjob: no SSH answer from {a.address}. Is the PC's setup done, and its network set to Private?")
    with tempfile.NamedTemporaryFile("w", suffix=".pub", delete=False) as t:
        t.write(line.split(" ", 1)[1] + "\n")
    fp = subprocess.run(["ssh-keygen", "-lf", t.name], capture_output=True, text=True).stdout.split()[1]
    os.unlink(t.name)
    print(f"PC fingerprint: {fp}")
    if not a.yes and input("Is this the same fingerprint the PC showed? [y/N] ").strip().lower() != "y":
        sys.exit("pcjob: not paired (fingerprints must match)")
    host_line = line.replace(a.address, HOST, 1)
    old = [l for l in (KNOWN.read_text().splitlines() if KNOWN.exists() else []) if not l.startswith(HOST + " ")]
    KNOWN.write_text("\n".join(old + [host_line]) + "\n")
    block = (f"\nHost {HOST}\n  HostName {a.address}\n  User {SSH_USER}\n  IdentityFile \"{KEY}\"\n  IdentitiesOnly yes\n"
             f"  UserKnownHostsFile \"{KNOWN}\"\n  StrictHostKeyChecking yes\n  HostKeyAlias {HOST}\n")
    conf = Path.home() / ".ssh" / "config"
    text = conf.read_text() if conf.exists() else ""
    if f"Host {HOST}\n" in text:   # replace our old block (it runs until the next Host line)
        start = text.index(f"Host {HOST}\n")
        nxt = text.find("\nHost ", start + 1)
        text = text[:start].rstrip("\n") + (text[nxt:] if nxt != -1 else "")
    conf.write_text((text.rstrip("\n") + "\n" if text.strip() else "") + block.lstrip("\n"))
    conf.chmod(0o600)
    CFG.update({"ssh_host": HOST, "pc_address": a.address, "pc_root": ROOT, "pc_os": OS_NAME})
    info = json.loads(on_pc(op_info))
    nets = info.get("networks", [])
    if isinstance(nets, dict):
        nets = [nets]
    mine = next((n for n in nets if n.get("ip") == a.address), nets[0] if nets else {})
    if mine.get("mac"):
        CFG["pc_mac"] = mine["mac"]
        net = ipaddress.ip_network(f"{a.address}/{mine.get('prefix', 24)}", strict=False)
        CFG["broadcast"] = [str(net.broadcast_address)]
    CONFIG.write_text(json.dumps(CFG, indent=1) + "\n")
    print(f"paired: ~/.ssh/config host '{HOST}' ({OS_NAME}), settings in {CONFIG}")
    print(f"PC: {info.get('gpu')}; Wake-on-LAN {'ready (' + CFG['pc_mac'] + ')' if CFG.get('pc_mac') and mine.get('wired') else 'needs a wired network cable'}")
    ok, age = runner_alive()
    print(f"job runner: {'up' if ok else 'DOWN'} (heartbeat {age}s ago)")


def main():
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")   # Windows pipes default to cp1252
    p = argparse.ArgumentParser(prog="pcjob", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="cmd", required=True)
    r = sub.add_parser("run"); r.add_argument("dir"); r.add_argument("--name"); r.add_argument("--timeout", type=int, default=3600)
    r.add_argument("--wait", action="store_true"); r.add_argument("--fetch", metavar="DEST")
    r.add_argument("--queue-max", type=int, default=QUEUE_MAX, help="with --wait/--fetch: seconds to wait in the PC's queue")
    r.add_argument("--cheap", action="store_true", help="wait for the cheap-electricity hours in config.json first")
    for n in ("status", "log", "cancel", "rm"):
        sub.add_parser(n).add_argument("id")
    w = sub.add_parser("wait"); w.add_argument("id"); w.add_argument("--max", type=int, default=7200, help="seconds of running")
    w.add_argument("--queue-max", type=int, default=QUEUE_MAX, help="seconds of waiting in the queue first")
    f = sub.add_parser("fetch"); f.add_argument("id"); f.add_argument("dest")
    sub.add_parser("put").add_argument("file")
    for n in ("list", "ping", "info", "wake", "push-runner", "cheap"):
        sub.add_parser(n)
    pr = sub.add_parser("pair"); pr.add_argument("address"); pr.add_argument("--yes", action="store_true", help="skip the fingerprint question")
    pr.add_argument("--os", choices=OS_CHOICES, help="what the PC runs (default: keep config.json's pc_os, else windows)")
    sl = sub.add_parser("sleep"); sl.add_argument("--hibernate", action="store_true", help="hibernate: fully off, no blinking sleep light (Windows)")
    sl.add_argument("--nobody-there", action="store_true", help="only when you know nobody is at the PC (session left unlocked); hibernate keeps their windows")
    a = p.parse_args()
    if a.cmd == "ping":
        print("PC reachable" if reachable() else "PC not reachable")
        if reachable():
            ok, age = runner_alive()
            print(f"runner: {'up' if ok else 'DOWN'} (heartbeat {age}s ago)")
    elif a.cmd == "wake":
        print("woke the PC" if wake() else "PC was already awake")
    elif a.cmd == "cheap":
        label, ws = cheap_source()
        if not ws:
            print('no cheap hours set (config.json "cheap_feed" or "cheap_hours")'
                  + (" - the live price feed is down right now" if CHEAP_FEED else ""))
        else:
            left = minutes_to_cheap()
            head = (f"cheap hours {span_text(ws)}" if label == "cheap_hours" else
                    f"cheapest {CHEAP_FEED_HOURS} h of the next 24 h, live from {label}: {span_text(ws)}")
            print(f"{head}: " + ("on now" if left == 0 else f"next in {left // 60} h {left % 60:02d} min")
                  + (f"; {CFG['cheap_hours_note']}" if CFG.get("cheap_hours_note") and label == "cheap_hours" else "")
                  + ("; every job waits for them" if CFG.get("cheap_only") else "; jobs wait only with --cheap or LAZY_CHEAP=1"))
    else:
        {"run": cmd_run, "status": cmd_status, "list": cmd_list, "log": cmd_log, "wait": cmd_wait,
         "fetch": cmd_fetch, "cancel": cmd_cancel, "rm": cmd_rm, "sleep": cmd_sleep, "put": cmd_put, "push-runner": cmd_push_runner,
         "pair": cmd_pair, "info": cmd_info}[a.cmd](a)


if __name__ == "__main__":
    main()
